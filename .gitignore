/assetgen_meta/prompt_opt/RESUME.md
!/assetgen_meta/traces_ist/
/assetgen_meta/traces_ist/*
!/assetgen_meta/traces_ist/m7e194es0ist2/
# placeholder: trace reports the final notebook will write
!/assetgen_meta/traces_ist/m7e194es0opt1_g54/

# ---------------------------------------------------------------- step1/ (occurrence profiles, relation maps)
!/step1/
/step1/*
!/step1/*.py
# imports relmap_proto, which no longer exists (renamed relmap_reader.py): broken, not published
/step1/hand_check_sample.py
!/step1/lasset_step1/
/step1/lasset_step1/*
