# Whitelist .gitignore for the public presentation repo.
# Everything is ignored by default; only the paths re-included with "!" are published.
# Ignoring is not deleting: every ignored file stays on disk.
# A directory must be re-included ("!/dir/") before any file inside it can be.
# Files that are ALREADY tracked are not affected by this file: untrack the ones not
# listed here with `git rm -r --cached <path>` (keeps the local copy).

/*

# ---------------------------------------------------------------- repo meta
!/.gitignore
!/.gitattributes
!/README.md
# reserved for a license of the author's own code, if one is added
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/requirements.txt

# ---------------------------------------------------------------- logs (July - October)
!/logs/
!/docs/

# ---------------------------------------------------------------- notebooks
# the final notebook and its helper, outputs and convergence table
!/FINAL_NOTEBOOK.ipynb
!/final/
# rebuilt by the notebook in about a minute; byte-identical to step1/lasset_step1/relation_map_code_*,
# assetgen_meta/traced_inputs_v2 and the data/parsed_* closed sets, which are published
/final/maps/
/final/traced_inputs/
/final/closed_sets/
# map fixes of 2026-10-09/10: code, READMEs and read-outs are published; the rebuilt files are not
# (run final/record_fields.py, then final/flow_entities.py, then final/record_scope.py; each self-tests its rebuild)
/final/record_fields/*/closed_sets/
/final/record_fields/*/maps/
/final/record_fields/*/occurrence_profiles/
/final/record_fields/*/traced_inputs/
/final/flow_entities/*/tuning/
/final/flow_entities/*/heldout/
# ablation notebooks
!/notebooks/

# ---------------------------------------------------------------- study code (src/), imported by the notebooks
!/src/

# ---------------------------------------------------------------- data: RTL, reference, closed sets
!/data/
# NEORV32 license: neorv32/ is a nested git clone (it has its own .git), so git cannot publish a single file
# from it; adding the folder would create an embedded-repo gitlink. Copy neorv32/LICENSE to
# third_party/NEORV32_LICENSE (BSD-3-Clause requires the notice to travel with the RTL) and keep neorv32/ ignored.
!/third_party/
# Step 2 rules (cited as S2 in docs/TIMELINE.md) and the provenance of the held-out closed sets in data/parsed_tuning18/
!/step2/

# ---------------------------------------------------------------- run folders (final prompt, its baselines, diagnosis inputs)
!/runs/
/runs/*
# final prompt (prompt_opt/v1) on gpt-5.4, tuning
!/runs/assets_tuning18_m7e194es0opt1_g54_r[0-2]/
# paired baseline: ist2 prompt on gpt-5.4
!/runs/assets_tuning18_m7e194es0ist2_g54_r[0-2]/
# ist2 prompt on gpt-5-mini
!/runs/assets_tuning18_m7e194es0ist2_r[0-2]/
# Claude-agent optimisation loop: v0 = ist2 prompt, v1 = final prompt; held-out check
!/runs/assets_opt_v0_r[0-1]/
!/runs/assets_opt_v1_r[0-2]/
!/runs/assets_opt_heldout_v0_r0/
!/runs/assets_opt_heldout_v1_r0/
# gpt-5-mini Step-1b winner and its pre-registered held-out reading (heldout_readings.json)
!/runs/assets_tuning18_m7e194es0ism_r[0-2]/
!/runs/assets_heldout26_m7e194es0ism_r[0-2]/
# placeholder: held-out runs the final notebook will write
!/runs/assets_heldout26_m7e194es0opt1_g54_r[0-9]/

# ---------------------------------------------------------------- assetgen_meta/ (generation, tracing, diagnosis)
!/assetgen_meta/
/assetgen_meta/*
!/assetgen_meta/*.py
!/assetgen_meta/*.md
!/assetgen_meta/*.txt
!/assetgen_meta/*.csv
!/assetgen_meta/heldout_readings.json
